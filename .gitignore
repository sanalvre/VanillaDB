# Tests (local development only)
tests/

# PyInstaller hook pycache
sidecar/hooks/__pycache__/

# Build virtualenv (used by PyInstaller CI builds, heavy)
sidecar/.venv-build/

# Windows binaries — built by CI, never committed
*.exe
*.msi

# Accidentally materialised shell-expansion paths
%USERPROFILE%/

# Tauri code-signing keys (never commit private keys)
**/.tauri/*.key
